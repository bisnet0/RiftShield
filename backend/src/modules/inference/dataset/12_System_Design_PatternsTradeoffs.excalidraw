      "y": 2415.611979166666,
      "width": 109.2,
      "height": 19.5,
      "text": "💡 WHY IT WORKS",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
